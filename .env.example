# .env.example  (SAFE PLACEHOLDERS ONLY — no real secrets)
# Copy this file to ".env" and fill in your real values locally.
# Never commit your real .env.

# MongoDB connection string (example format only; keep this blank)
# Movie Mentor durable creator state, ownership, recovery authority, and 5A.5
# inference entitlement/reservation authority use this shared durable database.
# No process-local inference-credit fallback is permitted.
MONGO_URI=

# Optional alternate var name used by some hosts
MONGODB_URI=

# Explicit comma-separated browser origins allowed to call protected Movie Mentor production surfaces.
# Example format only: https://app.example.com,https://preview.example.com
# Blank means no cross-origin browser authority. Wildcards are forbidden.
MOVIE_MENTOR_ALLOWED_BROWSER_ORIGINS=

# Server-owned Movie Mentor commercial package policy.
# Keep blank until launch pricing/provider terms are deliberately configured.
# Must be a non-empty JSON array. Creator/browser payloads may never override these values.
# Example shape only (NOT launch pricing):
# [{"packageId":"example-package","provider":"example-provider","providerProductId":"example-product","amountMinor":1000,"currency":"GBP","environment":"test","units":10,"policyVersion":"example-v1"}]
MOVIE_MENTOR_COMMERCIAL_POLICY_JSON=

# Server port (Render ignores this; local dev only)
PORT=10000
