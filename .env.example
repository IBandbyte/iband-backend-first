# .env.example  (SAFE PLACEHOLDERS ONLY — no real secrets)
# Copy this file to ".env" and fill in your real values locally.
# Never commit your real .env.

# MongoDB connection string (example format only; keep this blank)
MONGO_URI=

# Optional alternate var name used by some hosts
MONGODB_URI=

# Explicit comma-separated browser origins allowed to call protected Movie Mentor production surfaces.
# Example format only: https://app.example.com,https://preview.example.com
# Blank means no cross-origin browser authority. Wildcards are forbidden.
MOVIE_MENTOR_ALLOWED_BROWSER_ORIGINS=

# Server port (Render ignores this; local dev only)
PORT=10000
